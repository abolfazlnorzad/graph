    style Prometheus fill:#ff9800,stroke:#e65100,color:#000
    style Tempo fill:#7b1fa2,stroke:#4a148c,color:#fff
    style Loki fill:#00897b,stroke:#004d40,color:#fff
    style OTelCollector fill:#ab47bc,stroke:#7b1fa2,color:#fff
    style Service fill:#fff9c4,stroke:#f9a825,color:#000
    style Handler fill:#e3f2fd,stroke:#1565c0,color:#000
    style PostgresRepo fill:#c8e6c9,stroke:#2e7d32,color:#000
    style RedisCache fill:#ffcdd2,stroke:#c62828,color:#000
    style Middleware fill:#f3e5f5,stroke:#7b1fa2,color:#000
    style Validator fill:#fff3e0,stroke:#e65100,color:#000
    style Swagger fill:#e8eaf6,stroke:#3949ab,color:#000
