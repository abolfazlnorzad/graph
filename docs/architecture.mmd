graph TD
    Client["🌐 Client / Web / Mobile"]

    subgraph "Gin HTTP Server (port 8080)"
        Middleware["Middleware Layer\nErrorHandler | OTelTracing | OTelMetrics | RequestLogger"]
        Router["Gin Router"]
        Swagger["Swagger UI\n/swagger/*"]
        MetricsEP["Prometheus\n/metrics"]
    end

    subgraph "Delivery Layer"
        Handler["Task Handler\nCreate | Get | Update | Delete | List"]
    end

    subgraph "Service Layer"
        Service["Service\nBusiness Logic + Validation\nCache-Aside + SingleFlight"]
        Validator["Validator\nozzo-validation"]
    end

    subgraph "Repository Layer"
        PostgresRepo["PostgreSQL Repository\nCRUD + Audit Log\nOptimistic Locking\nSoft Delete"]
        RedisCache["Redis Cache Store\nSet | Get | Delete\nDeleteByPrefix | TTL"]
    end

    subgraph "Infrastructure"
        PostgresDB[("PostgreSQL 16\ntasks + task_audit_logs")]
        RedisDB[("Redis 7\nCache Store")]
        Prometheus["Prometheus\nMetrics Scraping"]
        Tempo["Tempo\nDistributed Tracing"]
        Loki["Loki\nLog Aggregation"]
        OTelCollector["OTel Collector\nOTLP → Prometheus + Tempo"]
    end

    Client -->|"HTTP REST"| Router
    Router --> Middleware
    Middleware --> Handler
    Swagger -.-> Router
    MetricsEP -.-> Router
    Handler --> Validator
    Handler --> Service

    Service -->|"Create/Update:\nDB Transaction"| PostgresRepo
    Service -->|"Get:\nParallel Goroutines"| PostgresRepo
    Service -->|"Cache Read/Write"| RedisCache

    PostgresRepo -->|"SQL Queries\n(Transactional)"| PostgresDB
    RedisCache -->|"Redis Commands"| RedisDB

    Service -.->|"OTel Spans"| OTelCollector
    Middleware -.->|"request_latency\nrequests_total"| OTelCollector
    Service -.->|"tasks_count\ntask_*_total"| OTelCollector

    OTelCollector -->|"Metrics"| Prometheus
    OTelCollector -->|"Traces"| Tempo

    Middleware -.->|"Structured Logs"| Loki

    style Client fill:#4fc3f7,stroke:#0288d1,color:#000
    style PostgresDB fill:#81c784,stroke:#388e3c,color:#000
